SANDRONE_HTTP_ADDR=:8080
SANDRONE_BOT_NAME=sandrone-review-bot
SANDRONE_LOG_LEVEL=info

GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=/app/secrets/sandrone.private-key.pem

MYSQL_DSN=sandrone:password@tcp(mysql:3306)/sandrone?charset=utf8mb4&parseTime=true&loc=UTC
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

SANDRONE_WORKER_CONCURRENCY=4
SANDRONE_PROVIDER_COOLDOWN=15m
SANDRONE_REQUEST_TIMEOUT=5m
SANDRONE_DELIVERY_RETENTION=24h

SANDRONE_PROVIDER_ORDER=gemini,groq,openrouter,nvidia

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

NVIDIA_API_KEY=
