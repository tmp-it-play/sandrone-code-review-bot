NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
SANDRONE_METRICS_TOKEN=
SANDRONE_BASE_PATH=
