SANDRONE_HTTP_ADDR=:8080
SANDRONE_LOG_LEVEL=info
SANDRONE_BASE_PATH=

GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=/app/secrets/sandrone.private-key.pem

MYSQL_DSN=sandrone:password@tcp(host.docker.internal:3306)/sandrone?charset=utf8mb4&parseTime=true&loc=UTC
REDIS_ADDR=host.docker.internal:6379
REDIS_PASSWORD=
REDIS_DB=0

SANDRONE_WORKER_CONCURRENCY=2
SANDRONE_PROVIDER_COOLDOWN=15m
SANDRONE_REQUEST_TIMEOUT=5m
SANDRONE_LLM_MAX_CALLS_PER_OPERATION=24
SANDRONE_PRIVATE_CODE_PROVIDERS=
SANDRONE_DELIVERY_RETENTION=96h
SANDRONE_REVIEW_RETENTION=4320h

GEMINI_API_KEY=

GROQ_API_KEY=

OPENROUTER_API_KEY=

NVIDIA_API_KEY=

MISTRAL_API_KEY=

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
SANDRONE_METRICS_TOKEN=

SANDRONE_TEMPLATE_DIR=web/template
SANDRONE_STATIC_DIR=web/static
