SANDRONE_HTTP_ADDR=:8080
SANDRONE_BOT_NAME=sandrone-review-bot
SANDRONE_LOG_LEVEL=info

GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=/app/secrets/sandrone.private-key.pem

MYSQL_DSN=sandrone:password@tcp(mysql:3306)/sandrone?charset=utf8mb4&parseTime=true&loc=UTC
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

SANDRONE_WORKER_CONCURRENCY=4
SANDRONE_PROVIDER_COOLDOWN=15m
SANDRONE_REQUEST_TIMEOUT=5m
SANDRONE_DELIVERY_RETENTION=24h

SANDRONE_PROVIDER_ORDER=gemini,githubmodels,groq,openrouter,nvidia

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
SANDRONE_METRICS_TOKEN=
