cd internal/core/llm
cat > role.go <<'EOF'
package llm

type Role string

const (
	RoleSystem    Role = "system"
	RoleUser      Role = "user"
	RoleAssistant Role = "assistant"
	RoleTool      Role = "tool"
)
EOF
cat > toolcall.go <<'EOF'
package llm

type ToolCall struct {
	ID        string
	Name      string
	Arguments string
}
EOF
cat > message.go <<'EOF'
package llm

type Message struct {
	Role       Role
	Content    string
	ToolCallID string
	ToolCalls  []ToolCall
}
EOF
cat > tool.go <<'EOF'
package llm

type Tool struct {
	Name        string
	Description string
	Parameters  map[string]any
}
EOF
cat > request.go <<'EOF'
package llm

type Request struct {
	Messages        []Message
	Temperature     float64
	MaxOutputTokens int
	Tools           []Tool
	ForceJSON       bool
}

func (r Request) WithMessages(messages []Message) Request {
	r.Messages = messages
	return r
}
EOF
cat > response.go <<'EOF'
package llm

type Response struct {
	Content      string
	ToolCalls    []ToolCall
	Provider     string
	Model        string
	FinishReason string
}

func (r Response) NeedsToolExecution() bool {
	return len(r.ToolCalls) > 0
}
EOF
cat > capability.go <<'EOF'
package llm

type Capability struct {
	ToolCalling bool
	JSONMode    bool
}
EOF
cat > failure.go <<'EOF'
package llm

import (
	"errors"
	"fmt"
)

type Failure struct {
	Provider string
	Kind     FailureKind
	Status   int
	Cause    error
}

func (f *Failure) Error() string {
	return fmt.Sprintf("%s: %s (status %d): %v", f.Provider, f.Kind, f.Status, f.Cause)
}

func (f *Failure) Unwrap() error {
	return f.Cause
}

func AsFailure(err error) (*Failure, bool) {
	var failure *Failure
	if errors.As(err, &failure) {
		return failure, true
	}
	return nil, false
}
EOF
cat > failurekind.go <<'EOF'
package llm

type FailureKind string

const (
	FailureQuota       FailureKind = "quota"
	FailureRateLimited FailureKind = "rate_limited"
	FailureUnavailable FailureKind = "unavailable"
	FailureInvalid     FailureKind = "invalid"
	FailureAuth        FailureKind = "auth"
)

func (k FailureKind) TriggersCooldown() bool {
	return k == FailureQuota || k == FailureRateLimited || k == FailureAuth
}
EOF
gofmt -l . && echo "fmt ok"
